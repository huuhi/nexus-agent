# ============================================================================
#  application-dev.yml 配置模板
# ----------------------------------------------------------------------------
#  用法：
#      cp nexus-agent-web/src/main/resources/application-dev.yml.example \
#         nexus-agent-web/src/main/resources/application-dev.yml
#      然后把下面所有 <<...>> 占位符替换成你自己的值。
#
#  ⚠️ application-dev.yml 已被 .gitignore 忽略，**不要提交**（含真实密钥）。
#  ⚠️ 本文件（.example）可以提交，只放占位符，绝不要写真实密钥进来。
#
#  为什么需要它：application.yml 里 spring.profiles.active=dev，
#  但仓库里并没有 application-dev.yml（被忽略了），所以不建这个文件应用起不来。
# ============================================================================

langchain4j:
  open-ai:
    # 同步模型：用于「生成会话标题」（ChatHistoryListServiceImpl 用的是 OpenAiChatModel）
    chat-model:
      model-name: moonshot-v1-8k
      base-url: https://api.moonshot.cn/v1
      api-key: <<MOONSHOT_API_KEY>>
    # 流式模型：默认对话模型
    streaming-chat-model:
      model-name: deepseek-v4-flash
      base-url: https://api.deepseek.com
      custom-parameters:
        enable_search: true
        enable_thinking: true
      api-key: <<DEEPSEEK_API_KEY>>
      return-thinking: true
    # 向量模型：知识库 / 向量检索。**dimensions 必须与数据库 vector(N) 一致**
    # 当前基线是 vector(1024)，改这里就要同步改 docs/sql 并重建向量
    embedding-model:
      api-key: <<DASHSCOPE_API_KEY>>
      base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
      model-name: text-embedding-v4
      dimensions: 1024

spring:
  datasource:
    # ⚠️ 多个 JDBC 参数之间必须用 & 分隔。
    # stringtype=unspecified 是 chat_memory.content::jsonb 等写入正常工作的前提。
    url: jdbc:postgresql://<<PG_HOST>>:5432/nexus_agent?reWriteBatchedInserts=true&stringtype=unspecified
    username: <<PG_USER>>
    password: <<PG_PASSWORD>>
    hikari:
      maximum-pool-size: 100
      minimum-idle: 5
      idle-timeout: 600000
      max-lifetime: 550000
      connection-timeout: 30000
      validation-timeout: 5000
      leak-detection-threshold: 60000

  # 邮件：发送登录/注册验证码（QQ 邮箱 SMTP）
  mail:
    host: smtp.qq.com
    port: 587
    username: <<QQ_MAIL>>
    password: <<QQ_SMTP_AUTH_CODE>>   # 注意是 SMTP 授权码，不是邮箱登录密码
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

  # 阿里云 OSS：图片与文件存储
  aliyun:
    bucket-name: <<OSS_BUCKET>>
    region: <<OSS_REGION>>            # 例：cn-guangzhou
    endpoint: https://<<OSS_ENDPOINT>>  # 例：oss-cn-guangzhou.aliyuncs.com
    image-dir: user/avatar
    file-dir: user/file

  data:
    redis:
      host: <<REDIS_HOST>>
      port: 6379
      password: <<REDIS_PASSWORD>>

# ============================================================================
#  nexus-agent 运行时参数（全部有代码默认值，不写这段也能启动）
# 对应类：com.huzhijian.nexusagentweb.properties.AgentProperties
# ============================================================================
nexus:
  agent:
    sse:
      # SSE 连接超时。必须大于最慢一次模型调用的耗时，否则复杂任务会被提前掐断
      timeout: 120s
    memory:
      # 对话记忆窗口的 token 上限（只影响送给模型的上下文，不影响已入库的消息）
      max-tokens: 100000
      # token 估算器使用的模型名。注意它只用于本地估算，不产生 API 调用；
      # 与真实使用的模型不一致会导致窗口裁剪不准，换主力模型时建议同步改
      token-estimator-model: gpt-4o
    sandbox:
      # 是否按会话复用沙盒。开启后同一会话内多次工具调用复用同一个沙盒（E2B 按量计费）
      reuse-per-session: true
      # 沙盒空闲多久后被后台任务主动销毁。
      # ⚠️ 必须小于沙盒服务里的 set_timeout(600)，否则还没轮到我们回收就被 E2B 收走了
      idle-timeout: 8m
      # 回收任务的执行间隔（毫秒，或 ISO-8601 时长）
      sweep-interval: 60000
    mcp:
      # MCP 客户端健康检查超时
      health-timeout: 5s
      # 是否缓存复用 MCP 客户端（关闭会导致每轮对话新建连接，必然泄漏）
      cache-clients: true
    security:
      # 是否启用登录鉴权。默认 true（安全优先）。
      # ⚠️ 本地调试若不想带 token，请在这里（自己不提交的 application-dev.yml）显式设为 false，
      #    不要注释掉 WebInterceptorConfig 上的 @Configuration —— 那样没有任何痕迹、容易误提交。
      #    关闭时启动日志会打 WARN 提醒。
      enabled: true
    skill:
      # 是否启用技能（本地目录扫描）
      enabled: true
      # 技能根目录：每个子目录一个技能，内含 SKILL.md（frontmatter 提供 name/description）
      # 目录约定与用法见 skills/README.md
      root-dir: skills
      # 目录扫描结果缓存时长。新增技能最多延迟这段时间生效，不需要重启
      refresh-interval: 60s
    startup:
      # 启动配置自检发现「必需配置缺失」时是否直接阻止启动。
      # true（默认）：fail-fast，启动日志会一次性列出缺哪些、各自什么后果
      # false：降级为 WARN 继续启动，仅建议临时排查问题时用
      fail-fast: true
    tools:
      # 工具发起的 HTTP 调用（沙盒服务）响应超时。
      # ⚠️ 刻意小于 sse.timeout(120s)：这样超时先由工具层抛出，
      #    变成结构化的 TIMEOUT 结果回给模型，而不是把整条 SSE 流掐断。
      #    长任务（沙盒里装依赖、跑大数据量脚本）可调大，但别超过 sse.timeout。
      http-timeout: 100s
      # 重复调用治理：同一会话内「同一工具 + 完全相同的参数」在窗口内超过阈值即拦截。
      # 设为 0 关闭该治理。
      duplicate-window: 60s
      duplicate-threshold: 2
    observability:
      # 是否输出每次运行的汇总日志（RUN runId=... tokens=... fee=... tools=...）
      enabled: true
      # 模型单价（每 100 万 token，单位：元）；没配的模型显示 fee=unpriced。
      # 支持最长前缀匹配（配 deepseek 可覆盖 deepseek-v4-flash）
      # model-prices:
      #   deepseek:
      #     input: 2.0
      #     output: 8.0
      model-prices: {}

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml

# ============================================================================
#  仅在本机需要额外配置的环境变量（Spring 读不到 yml 里的这些）
# ----------------------------------------------------------------------------
#  这些不是 yml 配置项，必须通过环境变量或 IDE 的运行配置传入：
#
#  JWT_SECRET        Base64 编码的 HMAC-SHA256 密钥。
#                    ⚠️ 不设置会随机生成，导致**每次重启后所有 token 失效**。
#                    生成：openssl rand -base64 32
#
#  API_KEY_SECRET    用户 API Key 的加密主密钥。
#                    ⚠️ 不设置会在首次保存配置时报错（EncryptorFactory fail-fast）。
#                    ⚠️ 一旦设置后不要更改，否则已加密的密钥全部无法解密。
#
#  BASE_URL          沙盒服务地址，默认 http://localhost:8000
# ============================================================================

logging:
  level:
    # 想看清模型调用了哪些工具，打开这一行（tracer 会打印工具名与参数）
    dev.langchain4j.service.tool: trace
    com.huzhijian.nexusagentweb: debug
