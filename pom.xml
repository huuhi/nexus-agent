<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.huzhijian</groupId>
    <artifactId>nexus-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>nexus-agent</name>
    <description>nexus-agent</description>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <langchain4j.version>1.12.1</langchain4j.version>
        <mybatis.version>3.5.6</mybatis.version>
        <!-- P3-4：SpringDoc OpenAPI（Spring Boot 3.5 对应 2.8.x）。
             升级 Spring Boot 大版本时要同步核对 springdoc 的兼容矩阵。 -->
        <springdoc.version>2.8.13</springdoc.version>
    </properties>
    <modules>
        <module>nexus-agent-web</module>
        <module>nexus-agent-service</module>
        <module>nexus-agent-mapper</module>
        <module>nexus-agent-common</module>
        <module>nexus-agent-domain</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- P3-4：API 文档。只有 nexus-agent-web 会引它（接口层才需要），
                 但版本在此统一管理，避免各模块各写一份。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
