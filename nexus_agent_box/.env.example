# ============================================================================
#  nexus_agent_box/.env 配置模板（FastAPI 沙盒服务）
# ----------------------------------------------------------------------------
#  用法：
#      cp nexus_agent_box/.env.example nexus_agent_box/.env
#      然后替换占位符
#
#  ⚠️ .env 已被 .gitignore 忽略，不要提交（含真实密钥）。
# ============================================================================

# E2B 云沙盒的 API Key（必需）
# 申请：https://e2b.dev  →  Dashboard → API Keys
E2B_API_KEY=<<E2B_API_KEY>>

# 自定义沙盒模板 id（可选，留空 = 用 E2B 基础模板）
# 自定义模板预装：python-docx / openpyxl / python-pptx / matplotlib / dotnet SDK 8 / 中文字体
# 构建方式见 nexus_agent_box/e2b/Dockerfile.template（需要你在本机执行）：
#     e2b template build <your-template-id> --dockerfile nexus_agent_box/e2b/Dockerfile.template
# ⚠️ 留空不影响功能，但 AI 生成 Office 文档时每次都要现场 pip install；
#    且技能自带的 scripts/*.csx（minimax-docx 等）会因没有 dotnet 而无法运行。
E2B_TEMPLATE_ID=

# 阿里云 OSS 凭证（沙盒内下载文件后回传 OSS 时需要）
# app/utils/oss_utils.py 用的是 oss2 的 EnvironmentVariableCredentialsProvider，
# 因此必须用这两个固定名字，不能改名：
ALIBABA_CLOUD_ACCESS_KEY_ID=<<ALIYUN_ACCESS_KEY_ID>>
ALIBABA_CLOUD_ACCESS_KEY_SECRET=<<ALIYUN_ACCESS_KEY_SECRET>>
