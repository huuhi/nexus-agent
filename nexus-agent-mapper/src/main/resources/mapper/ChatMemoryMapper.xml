<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huzhijian.nexusagentweb.mapper.ChatMemoryMapper">

    <resultMap id="BaseResultMap" type="com.huzhijian.nexusagentweb.domain.ChatHistory">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="content" column="content" jdbcType="OTHER"/>
            <result property="type" column="type" jdbcType="OTHER"/>
            <result property="createAt" column="create_at" jdbcType="TIMESTAMP"/>
            <result property="sessionId" column="session_id" jdbcType="OTHER"/>
            <!-- 产物归属（方案 B）：这一行是「哪一次运行」写进来的。老数据为 NULL -->
            <result property="runId" column="run_id" jdbcType="VARCHAR"/>
            <!-- 2026-10-06：非空 = 这条回答已被更新的回答替代（重新生成）。老数据/未替代为 NULL -->
            <result property="supersededBy" column="superseded_by" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,content,
        type,create_at,session_id,run_id,superseded_by
    </sql>
    <insert id="insertBatch" parameterType="java.util.List">
        insert into chat_memory(content,type,session_id,user_id,run_id) values
        <foreach collection="list" item="item" separator=",">
            (#{item.content}::jsonb,#{item.type}::message_type,#{item.sessionId}::uuid,#{userId},#{item.runId})
        </foreach>
    </insert>
    <delete id="delAllByMemoryId">
        delete from chat_memory where session_id=#{sessionId}::uuid

    </delete>
    <!--
      注意：这里**必须显式列出列名**，不能用 select *。
      原因：resultMap 的列顺序是 create_at 在前、session_id 在后，
      而表的物理顺序是 session_id 在前、create_at 在后。
      用 select * 时 MyBatis 会按位置套用 resultMap，
      导致用 Timestamp 处理器去读 uuid 列，报
      "Bad value for type timestamp/date/time: <uuid>"。
      显式列出并保持与 resultMap 一致，可彻底避免这个问题。
    -->
    <select id="getAllByMemoryId" resultMap="BaseResultMap">
        select id,user_id,content,type,create_at,session_id,run_id,superseded_by
        from chat_memory where session_id=#{sessionId}::uuid
        order by create_at
    </select>

    <!-- 对外读取历史：同时限定 user_id，防止越权读取他人会话 -->
    <select id="getAllByMemoryIdAndUserId" resultMap="BaseResultMap">
        select id,user_id,content,type,create_at,session_id,run_id,superseded_by
        from chat_memory
        where session_id=#{sessionId}::uuid
          and user_id=#{userId}
        order by create_at
    </select>

    <!--
      对话链路读历史（2026-10-06）：只取最近 #{limit} 条。
      写法是先倒序取 N 条、再正序还原 —— 直接 order by create_at limit N 会拿到
      **最早**的 N 条，正好相反。排序里的 id 兜底与 getLastContentByMemoryId 同理：
      同一批 insertBatch 的多行共享同一个 create_at。
      ⚠️ limit <= 0 表示不限制，此时退化为全量查询（SQL 里用 #{limit} 直接拼，
         但它是 int 类型参数，不存在注入风险）。
    -->
    <select id="getRecentForChat" resultMap="BaseResultMap">
        select id,user_id,content,type,create_at,session_id,run_id,superseded_by
        from (
            select id,user_id,content,type,create_at,session_id,run_id,superseded_by
            from chat_memory
            where session_id=#{sessionId}::uuid
              and user_id=#{userId}
            order by create_at desc, id desc
            limit #{limit}
        ) t
        order by t.create_at, t.id
    </select>

    <!--
      🔴 记忆加载专用（2026-10-06）：与 getRecentForChat 唯一的差别是**排除被替代的回答**。
      <p>
      背景：「重新生成」会让同一个问题产生多版回答。模型上下文只能要当前生效的那一版，
      否则会同时看到「问过两遍、答过两遍」—— 既白烧 token（直接踩首字延迟这条线），
      又让模型困惑；而且前端的 n/n 切换会形同虚设：用户切回 1/2 接着聊，
      模型上下文里 2/2 的内容一个字没少。
      <p>
      ⚠️ **历史接口不能用这一条**：前端做 n/n 切换需要看到全部版本，
      被替代的只是「不参与模型上下文」，不是「不存在」（见 getAllByMemoryIdAndUserId）。
    -->
    <select id="getActiveForChat" resultMap="BaseResultMap">
        select id,user_id,content,type,create_at,session_id,run_id,superseded_by
        from (
            select id,user_id,content,type,create_at,session_id,run_id,superseded_by
            from chat_memory
            where session_id=#{sessionId}::uuid
              and user_id=#{userId}
              and superseded_by is null
            order by create_at desc, id desc
            limit #{limit}
        ) t
        order by t.create_at, t.id
    </select>

    <!--
      重新生成后，把「比 #{sinceId} 更新的、还没被替代的」旧消息标记为已被 #{newId} 替代。
      <p>
      🔴 三个条件缺一不可，写的时候逐个对着想一遍：
      <ol>
        <li><b>id &gt;= #{sinceId}</b> —— sinceId 是用户点重新生成时所在<b>那条</b>回答。
            所以条件是「<b>从它自己开始</b>」而不是「比它更新的」：
            <b>用 {@code >} 会漏掉用户点的这一条</b>（写完第一版就是这么错的，
            表现是「切回 1/2 继续问，模型仍记得 2/2」—— 切换形同虚设）。
            而它的<b>问题在它之前</b>（id 更小），所以问题不会被卷进来 ——
            问题被标记掉的话，模型下一轮就不知道在回答谁了。</li>
        <li><b>superseded_by is null</b> —— 已经出局的不反复改写。</li>
        <li><b>run_id is distinct from #{excludeRunId}</b> —— <b>本次运行刚写的消息不能被标记</b>。
            不加这一条，新回答会把自己标成被自己替代，记忆加载时被排除，
            用户刚点重新生成就"什么都没发生"。</li>
        <li><b>type &lt;&gt; 'USER'</b> —— 用户提问永远不该有 superseded_by（第二道保险）。</li>
      </ol>
      <p>
      ⚠️ 这条语句的语义是「<b>回到旧版本继续对话 = 开一条新分支</b>」：
      用户在 1/2 上重新生成时，1/2 之后聊过的内容也一并让位。
      这与 ChatGPT 的分支语义一致，不是缺陷。
    -->
    <update id="markSupersededSince">
        update chat_memory
        set superseded_by = #{newId}
        where session_id=#{sessionId}::uuid
          and user_id=#{userId}
          and id &gt;= #{sinceId}
          and superseded_by is null
          and run_id is distinct from #{excludeRunId}
          and type &lt;&gt; 'USER'::message_type
    </update>

    <!--
      按 runId 找本次运行写入的**第一条 AI 回答**的 id。
      用途：重新生成时它就是「新版本的 id」，要写进被替代行的 superseded_by。
      为什么不用 insert 的返回值：insertBatch 是 <foreach> 批量插入且带 ON CONFLICT 兜底，
      让它返回 id 列表要改成 RETURNING，多一层 CTE；
      而一次运行只会有一条 AI 回答（多轮工具调用也只有一条最终回答），按 runId 查更稳。
      <p>
      ⚠️ 排除 TOOL_EXECUTION_RESULT：工具结果的 type 不是 'AI'，天然不会命中。
    -->
    <select id="findFirstAiMessageIdOfRun" resultType="java.lang.Long">
        select id
        from chat_memory
        where session_id=#{sessionId}::uuid
          and user_id=#{userId}
          and run_id=#{runId}
          and type='AI'::message_type
        order by id
        limit 1
    </select>

    <!--
      该会话下、属于这次运行的历史行是否已存在（2026-10-06：叫停补写前的幂等守卫）。
      ⚠️ run_id 为 NULL 的老数据不会匹配上 —— 这是对的：老数据不是"这次运行"写的。
    -->
    <select id="existsByRunId" resultType="boolean">
        select exists (
            select 1
            from chat_memory
            where session_id=#{sessionId}::uuid
              and user_id=#{userId}
              and run_id=#{runId}
        )
    </select>

    <!--
      取某个会话**最后一条**消息的原始 JSON，用作增量写入的「锚点」。
      排序说明：同一批 insertBatch 的多行共享同一个 create_at（默认值 now() 在一条语句里相同），
      所以必须再用 id 兜底。chat_memory 的行全部由 insertBatch 写入（identity 自增），
      因此 id 与时间同向递增，排序结果确定。
    -->
    <select id="getLastContentByMemoryId" resultType="java.lang.String">
        select content::text
        from chat_memory
        where session_id=#{sessionId}::uuid
          and user_id=#{userId}
        order by create_at desc, id desc
        limit 1
    </select>

    <!--
      取会话最近 N 条消息的原始 JSON，用于「锚点失配」时的兜底去重。
      返回按时间正序，便于调用方比对。
    -->
    <select id="getRecentContents" resultType="java.lang.String">
        select t.content::text
        from (
            select content, create_at, id
            from chat_memory
            where session_id=#{sessionId}::uuid
              and user_id=#{userId}
            order by create_at desc, id desc
            limit #{limit}
        ) t
        order by t.create_at, t.id
    </select>

    <!-- ===================================================================
      会话搜索（P3-1 补）—— 把一条消息的「正文」抽成纯文本再做 ILIKE。

      content 是 jsonb，存的是 langchain4j 一条 ChatMessage 的序列化结果，
      不同消息类型里正文的位置不一样：
        · AiMessage / SystemMessage / ToolExecutionResultMessage → 顶层 "text"
        · UserMessage                                            → "contents": [{"text": "..."}]

      ⚠️ 因此**不能直接写 content::text ilike** —— 那样会把 JSON 的键名
      （"type"、"text"、"USER"、"AI" …）也当成正文，用户搜 type 会命中全部会话。
      下面的表达式把两种位置都抽出来拼平，只匹配真正的对话内容。

      ⚠️ jsonb_array_elements 遇到非数组会报错，所以先用 jsonb_typeof 判断；
      没有 contents 键时 content->'contents' 是 SQL NULL，走 else 分支返回空数组。
      =================================================================== -->
    <sql id="MessageTextExpr">
        coalesce(m.content-&gt;&gt;'text', '') || ' ' ||
        coalesce((select string_agg(e-&gt;&gt;'text', ' ')
                  from jsonb_array_elements(
                          case when jsonb_typeof(m.content-&gt;'contents') = 'array'
                               then m.content-&gt;'contents'
                               else '[]'::jsonb end) e), '')
    </sql>

    <resultMap id="SearchHitResultMap" type="com.huzhijian.nexusagentweb.domain.ChatMemorySearchHit">
        <result property="sessionId" column="session_id" jdbcType="VARCHAR"/>
        <result property="snippet" column="snippet" jdbcType="VARCHAR"/>
        <result property="createAt" column="create_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!--
      说明几点：
      1) session_id 显式 ::text —— 列是 uuid，转成 text 后 resultMap 用 VARCHAR 接，
         避免「用 Timestamp 处理器读 uuid 列」那类类型错配。
      2) escape '\' 必须有：pattern 里的 % 和 _ 已在 Java 侧转义成 \% \_，
         但没有 escape 子句时 PostgreSQL 不认 \%（默认没有转义符），
         用户搜一个 "%" 就会退化成「匹配全部」。
      3) 排除 SYSTEM 消息：那是系统提示词，不属于用户能看见的对话内容，
         搜出来会让结果莫名其妙。
      4) limit 兜底：命中消息可能成千上万，只取最近的一批去聚合。
    -->
    <select id="searchHits" resultMap="SearchHitResultMap">
        select m.session_id::text as session_id,
               <include refid="MessageTextExpr"/> as snippet,
               m.create_at       as create_at
        from chat_memory m
        where m.user_id = #{userId}
          and m.content-&gt;&gt;'type' &lt;&gt; 'SYSTEM'
          and <include refid="MessageTextExpr"/> ilike #{pattern} escape '\'
        order by m.create_at desc, m.id desc
        limit #{limit}
    </select>
</mapper>
