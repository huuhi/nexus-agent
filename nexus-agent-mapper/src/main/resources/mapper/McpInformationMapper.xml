<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huzhijian.nexusagentweb.mapper.McpInformationMapper">

    <resultMap id="BaseResultMap" type="com.huzhijian.nexusagentweb.domain.McpInformation">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="url" column="url" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="header" column="header" jdbcType="VARCHAR"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="type" column="type" jdbcType="VARCHAR"/>
            <result property="logoUrl" column="logo_url" jdbcType="VARCHAR"/>
            <result property="available" column="available" jdbcType="BOOLEAN"/>
            <result property="strId" column="str_id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,url,
        description,header,user_id,
        type
    </sql>
    <insert id="saveBatch">
        insert into mcp_information (name, url, description, header, user_id, type, logo_url,str_id) values
        <foreach collection="list" item="item" separator=",">
         (#{item.name},#{item.url},#{item.description},#{item.header,jdbcType=VARCHAR}::jsonb,#{item.userId},#{item.type},#{item.logoUrl},#{item.strId})
        </foreach>
    </insert>
    <update id="updateMCP">
        update mcp_information
        set name = #{name},
            url = #{url},
            description = #{description},
            <!--
              ⚠️ header 是 jsonb 列，Java 侧是 String。**必须显式 ::jsonb**：
              不加的话 PG 报「column "header" is of type jsonb but expression is of type
              character varying」（与 UserConfigMapper 的 llm_api_token 同款问题）。
            -->
            header = #{header,jdbcType=VARCHAR}::jsonb,
            type = #{type},
            logo_url = #{logoUrl},
            available = #{available}
        where id = #{id}
          and user_id = #{userId}
    </update>
</mapper>
