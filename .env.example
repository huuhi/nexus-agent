# ============================================================================
#  nexus-agent —— 应用的环境变量模板（复制成 .env 后填真实值）
# ----------------------------------------------------------------------------
#  用法 A（docker compose，推荐）：
#      cp .env.example .env                                # 填好真实值再上传服务器
#      cp nexus_agent_box/.env.example nexus_agent_box/.env # 沙盒服务也要一份
#      docker compose up -d --build
#      docker compose ps                                   # 四个服务都 healthy 才算起来
#
#  用法 B（不打容器，直接跑 jar）—— ⚠️ Spring Boot **不会**自动读 .env，
#      java -jar 之前必须自己 export 出来，否则所有变量都是空的，
#      启动会直接失败（不是警告）：
#          set -a; . ./.env; set +a
#          exec java $JAVA_OPTS -jar nexus-agent-web.jar
#      （systemd 的话用 EnvironmentFile=/path/to/.env，别写成 Environment=）
#
#  ⚠️ .env 已被 .gitignore 忽略，**不要提交**（里面是真实密钥）。
#     本仓库还有另一份 nexus_agent_box/.env（沙盒服务 FastAPI 用），两份都要填，
#     而且 **OSS 的变量名两边不一样**（见下面「阿里云 OSS」那节）。
#
#  填完后在服务器上跑一次自查（告诉你缺什么、有没有漏改的占位符）：
#      bash scripts/check-env.sh
# ============================================================================

# ---------------------------------------------------------------------------
# 一、必需（缺了应用起不来）
# ---------------------------------------------------------------------------
#  判定标准：`application-prod.yml` 里写成 ${XXX} 且**没有默认值**，
#  Spring 解析不到占位符会在创建 Bean 时抛
#      IllegalArgumentException: Could not resolve placeholder 'XXX'
#  这是**启动失败**，不是 WARN。所以下面这些一个都不能少。
#  （scripts/check-env.sh 会直接从那个 yml 里抽 ${} 占位符来查，改名不会漂移。）

# PostgreSQL 与 Redis 所在的主机。
#   · 用仓库根目录 docker-compose.yml 起全套 → 用下面的 postgres（compose 服务名）
#   · 用外部已有的库 → **必须改成**它的 IP / 域名（写 localhost 会连到应用自己）
SERVICE_IP=postgres

# PostgreSQL 密码（prod yml：spring.datasource.password: ${DATABASE}）
DATABASE=<<POSTGRES_PASSWORD>>

# Redis 密码（prod yml：spring.data.redis.password: ${REDIS_PWD}；
# 注意改 compose 里 redis 的密码时要两边一起改）
REDIS_PWD=<<REDIS_PASSWORD>>

# 流式对话模型的 Key（系统默认主力模型，application-prod.yml 里 ${DEEPSEEK}）。
# 缺了 → 任何对话都会失败。
DEEPSEEK=<<DEEPSEEK_API_KEY>>

# 会话标题生成模型的 Key（moonshot，${MOONSHOT}）。
MOONSHOT=<<MOONSHOT_API_KEY>>

# 向量模型 Key（阿里百炼 / DashScope，${ALI_AI_KEY}）。知识库入库与检索都用它。
# （旧版这里叫 AI_KEY，prod yml 改名后两边要同步）
ALI_AI_KEY=<<DASHSCOPE_API_KEY>>

# 邮箱验证码（注册 / 找回密码）。QQ 邮箱填邮箱地址 + **SMTP 授权码**（不是登录密码）。
MAIL_USERNAME=<<YOUR_QQ_EMAIL>>
MAIL_PASSWORD=<<YOUR_SMTP_AUTH_CODE>>

# 用户自带 API Key 的加密主密钥（EncryptorFactory 直接读 System.getenv，不在 yml 里）。
# ⚠️ 一旦上线就**不要再改** —— 改了库里已加密的用户 Key 全部解不开。
# 生成：openssl rand -base64 32
API_KEY_SECRET=<<API_KEY_SECRET>>

# ---------------------------------------------------------------------------
# 二、强烈建议（不填也能启动，但会出现下面这些"看起来像 bug"的现象）
# ---------------------------------------------------------------------------

# JWT 签名密钥。
# ⚠️ 不设置会随机生成 → **每次重启后所有人的 token 立即失效**，用户被踢下线。
# 生成：openssl rand -base64 32
JWT_SECRET=<<JWT_SECRET>>

# 阿里云 OSS —— 用户头像、附件上传、会话产物删除都依赖它。
# ⚠️ 变量名是 **OSS_ 前缀**：AliOssUtil 用阿里云 SDK 的
#    EnvironmentVariableCredentialsProvider，它只认这两个名字。
#    **不要**写成沙盒服务那套 ALIBABA_CLOUD_ 前缀 —— 那是 Python 侧（oss2）用的。
#    缺了 → 启动不报错，但一上传头像/文件就失败（最难排查的那类问题）。
OSS_ACCESS_KEY_ID=<<ALIYUN_ACCESS_KEY_ID>>
OSS_ACCESS_KEY_SECRET=<<ALIYUN_ACCESS_KEY_SECRET>>

# ---------------------------------------------------------------------------
# 三、可选（有默认值，一般不用动）
# ---------------------------------------------------------------------------

# 沙盒服务（FastAPI / E2B）地址。默认 http://localhost:8000。
# ⚠️ 用 docker compose 起全套时要填 http://box:8000（容器网络互访用服务名）。
# BASE_URL=http://box:8000

# 跨域白名单（前后端**分离**部署时需要；Nginx 同源部署就完全不用开）。
# ⚠️ 这两行**改完不用重新打包**，重启即可生效 —— 它们是运行时配置，不是构建期配置。
# 变量名规则：全大写 + 点变下划线，对应 nexus.agent.cors.{enabled,allowed-origins}。
#   NEXUS_AGENT_CORS_ENABLED=true
#   NEXUS_AGENT_CORS_ALLOWED_ORIGINS=http://120.235.30.202:5173
# ❗ 注意：jar 跑的是 prod profile，读的是 application-prod.yml（那里 allowed-origins
#    默认为空 = 不开跨域）。改 application.yml 里那一行对 prod **无效**。

# Spring profile。镜像里没有 application-dev.yml（被 gitignore），
# 所以**容器里必须跑 prod**；docker-compose.yml 已经设好，单独 docker run 时要带上。
SPRING_PROFILES_ACTIVE=prod

# JVM 参数。Dockerfile 里默认 -XX:MaxRAMPercentage=75.0（按容器内存上限取 75%）。
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Xms512m

# ---------------------------------------------------------------------------
# 四、填值注意事项
# ---------------------------------------------------------------------------
#  1. `=` 两边**不要留空格**（`KEY = value` 会让 key 名带上空格）。
#  2. 值里含 `#`、`$`、空格时用**双引号**包起来：MAIL_PASSWORD="ab#c$ d"
#  3. 不要加 `export ` 前缀 —— docker compose 的 env_file 不认。
#  4. 所有 `<<...>>` 占位符都要替换掉，一个都别留（check-env.sh 会查）。
