# ============================================================================
#  nexus-agent / 应用镜像的环境变量模板（P3-3）
# ----------------------------------------------------------------------------
#  用法：
#      cp .env.example .env
#      然后替换所有 <<...>> 占位符
#
#  ⚠️ .env 已被 .gitignore 忽略，**不要提交**（里面是真实密钥）。
#     本文件与 nexus_agent_box/.env.example 是两份不同的文件：
#     那是**沙盒服务**（FastAPI）用的，这份是 **Java 应用**用的。
# ============================================================================

# ---------------------------------------------------------------------------
# 一、密钥（缺了启动自检会 fail-fast 拒绝启动）
# ---------------------------------------------------------------------------
# JWT 签名密钥。不设置会随机生成 → 每次重启后所有人的 token 全部失效。
# 生成：openssl rand -base64 32
JWT_SECRET=<<JWT_SECRET>>

# 用户 API Key 的加密主密钥（EncryptorFactory 直接读 System.getenv）。
# ⚠️ 设置后**不要更改**，否则库里已加密的用户 Key 全部解不开。
API_KEY_SECRET=<<API_KEY_SECRET>>

# ---------------------------------------------------------------------------
# 二、模型服务 Key（application-prod.yml 里以 ${...} 引用）
# ---------------------------------------------------------------------------
# 系统默认对话模型（moonshot）
MOONSHOT=<<MOONSHOT_API_KEY>>
# 流式对话模型（deepseek）
DEEPSEEK=<<DEEPSEEK_API_KEY>>
# 向量模型（dashscope / 阿里百炼）—— 知识库入库与检索都用它
AI_KEY=<<DASHSCOPE_API_KEY>>

# ---------------------------------------------------------------------------
# 三、地址与邮件
# ---------------------------------------------------------------------------
# PostgreSQL 与 Redis 所在的主机。
# 用仓库根目录的 docker-compose.yml 起全套时填 **postgres**（compose 服务名）；
# 用外部的库就填它的 IP / 域名。
SERVICE_IP=postgres

# 邮箱验证码（注册 / 重置密码）。配错只会让验证码发不出去，不影响启动。
MAIL_USERNAME=<<YOUR_QQ_EMAIL>>
MAIL_PASSWORD=<<YOUR_SMTP_AUTH_CODE>>

# ---------------------------------------------------------------------------
# 四、可选
# ---------------------------------------------------------------------------
# 沙盒服务地址。用 docker-compose 起全套时填 http://box:8000（服务名）；
# 不填则用默认 http://localhost:8000。
# BASE_URL=http://box:8000

# Spring profile。镜像里没有 application-dev.yml（被 gitignore），
# 所以**容器里必须跑 prod**；docker-compose.yml 已经设好，单独 docker run 时要带上。
SPRING_PROFILES_ACTIVE=prod
